# 复制为 .env 后按实际路径修改；不要把真实 .env 提交到仓库。
# 用法：set -a; source .env; set +a

# ============================================================
# 平台核心
# ============================================================
RAG_DATA_DIR=./data
RAG_INDEX_DIR=./data/index
RAG_MANIFEST=./data/manifest.db

# 平台运行在 rag conda 环境；docparse 通过子进程调用
# 索引后端：milvus（主）| keyword（离线回退）
PLATFORM_INDEX_BACKEND=milvus

# Connector 插件目录与开关（核心不按数据源类型写分支）
CONNECTORS_DIR=./connectors
CONNECTOR_TXT_ENABLED=true
CONNECTOR_MARKDOWN_ENABLED=true
CONNECTOR_PDF_ENABLED=true

# ============================================================
# docparse 多模态解析
# ============================================================
# 指向包含 docparse/ 包的目录，不要写死别人的 home 路径。
DOCPARSE_REPO=./已有资源/可选组件/docparse
# 解析环境 docparse 的 python，例如：conda run -n docparse which python
DOCPARSE_PYTHON=/path/to/conda/envs/docparse/bin/python
DOCPARSE_MODE=auto            # auto | page | region
DOCPARSE_TIMEOUT_S=1800
DOCPARSE_LAYOUT_DEVICE=cpu    # cpu | gpu:0
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
TOKENIZERS_PARALLELISM=false

# ============================================================
# Ollama（OCR 模型，只监听 loopback）
# ============================================================
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_LOADED_MODELS=1

XIAOMI_OCR_MODEL=longwayxu/xiaomi-ocr-0:bf16
XIAOMI_OCR_LOCAL_URL=http://127.0.0.1:11434/v1

# ============================================================
# Milvus（Docker）
# ============================================================
MILVUS_URI=http://localhost:19530
MILVUS_DB=course_rag
MILVUS_COLLECTION=course_chunks

# 混合检索权重（dense 权重高于 BM25）
MILVUS_DENSE_WEIGHT=0.7
MILVUS_SPARSE_WEIGHT=0.3

# ============================================================
# 嵌入模型（provider + model）
# ============================================================
# local | hashing | dashscope | openai | ollama
EMBED_BACKEND=local
# 留空/0 表示使用 provider 默认；换模型必须同时设置正确 dim 并新建集合
EMBED_MODEL=
EMBED_DIM=0
# 覆盖 provider 默认 base URL（可选）
EMBED_BASE_URL=

# API Key 只从环境变量读取，不写入 .env 以外的仓库文件
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# HuggingFace 缓存/镜像（可选）
# HF_ENDPOINT=https://hf-mirror.com
# HF_HOME=~/.cache/huggingface

# 重排（可选）
RERANK_MODEL=gte-rerank-v2
DASHSCOPE_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# ============================================================
# 问答模型（可选；空表示只做检索，不生成答案）
# ============================================================
# deepseek | dashscope | openai | ollama
CHAT_PROVIDER=
CHAT_MODEL=
CHAT_BASE_URL=
CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=1024
RAG_TOP_K=5

# 问答/查询扩写 Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# 查询扩写（可选）
# ============================================================
QUERY_EXPAND=false
