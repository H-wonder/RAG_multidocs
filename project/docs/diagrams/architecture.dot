digraph architecture {
  rankdir=LR;
  graph [fontname="Noto Sans CJK SC", fontsize=11, pad=0.3, nodesep=0.35, ranksep=0.55];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=10,
        fillcolor="#eef3fb", color="#5b7db1"];
  edge [fontname="Noto Sans CJK SC", fontsize=9, color="#555555"];

  user [label="用户\nCLI", fillcolor="#fff2cc", color="#bf9000"];
  cli [label="CLI 适配器\n(rag-cli)", fillcolor="#fff2cc", color="#bf9000"];

  subgraph cluster_core {
    label="Core（Python 标准库）";
    fontname="Noto Sans CJK SC";
    color="#b4c6e7";
    style="rounded,dashed";
    ingest [label="IngestService"];
    search [label="SearchService"];
    registry [label="ConnectorRegistry"];
    chunker [label="Chunker\nTXT / Markdown / IR"];
    backend [label="IndexBackend\n统一接口"];
  }

  subgraph cluster_connectors {
    label="Connector（统一契约）";
    fontname="Noto Sans CJK SC";
    color="#c6e0b4";
    style="rounded,dashed";
    txt [label="TXT\n内置", fillcolor="#e2f0d9", color="#548235"];
    pdf [label="PDF / 扫描件 / Office\n内置", fillcolor="#e2f0d9", color="#548235"];
    md [label="Markdown 目录\n独立扩展", fillcolor="#e2f0d9", color="#548235"];
  }

  subgraph cluster_index {
    label="索引后端";
    fontname="Noto Sans CJK SC";
    color="#ffd966";
    style="rounded,dashed";
    milvus_idx [label="MilvusIndex\ndense + BM25（主）", fillcolor="#fff2cc", color="#bf9000"];
    keyword_idx [label="KeywordIndex\nBM25（回退）", fillcolor="#f2f2f2", color="#777777"];
  }

  qa [label="RagQA\n证据 prompt + 引用", fillcolor="#fff2cc", color="#bf9000"];
  chat [label="ChatModel\nDeepSeek / DashScope / OpenAI / Ollama", fillcolor="#fce4d6", color="#c55a11"];
  embedder [label="Embedder\nbge / DashScope / OpenAI / Ollama / hashing", fillcolor="#fce4d6", color="#c55a11"];
  milvus [label="Docker Milvus\nmilvus-standalone:19530", fillcolor="#fce4d6", color="#c55a11"];
  docparse [label="docparse 子进程\n(docparse conda env)", fillcolor="#fce4d6", color="#c55a11"];
  ollama [label="Ollama\nXiaomi-OCR-0", fillcolor="#fce4d6", color="#c55a11"];
  disk [label="index.json\n关键词回退持久化", shape=cylinder, fillcolor="#ededed", color="#777777"];

  user -> cli [label="ingest / search"];
  cli -> ingest [label="ingest"];
  cli -> search [label="search / ask"];
  search -> qa [label="top-k evidence"];
  qa -> chat [label="answer + [n] citations"];
  ingest -> registry [label="load(name)"];
  registry -> txt;
  registry -> pdf;
  registry -> md [label="manifest"];
  ingest -> chunker;
  chunker -> backend [label="Chunk"];
  search -> backend [label="query"];
  backend -> milvus_idx [label="index_backend=milvus"];
  backend -> keyword_idx [label="回退 / keyword"];
  milvus_idx -> embedder [label="embed"];
  milvus_idx -> milvus [label="pymilvus"];
  keyword_idx -> disk [label="save/load"];
  pdf -> docparse [label="subprocess"];
  docparse -> ollama [label="loopback HTTP"];
}
